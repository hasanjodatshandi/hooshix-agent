{
  "name": "hooshix-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index-http.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "installer:windows": "node scripts/build-windows-installer.mjs",
    "service:build": "cd deploy/windows && go build -trimpath -ldflags \"-s -w\" -o build/bin/hooshix-mcp-service.exe ./cmd/hooshix-mcp-service",
    "service:status": "deploy\\windows\\build\\bin\\hooshix-mcp-service.exe status",
    "service:restart": "deploy\\windows\\build\\bin\\hooshix-mcp-service.exe service restart",
    "lint": "node scripts/verify-g1-global.mjs && node scripts/r7-secret-policy-check.mjs",
    "typecheck": "tsc -p tsconfig.r1.json && tsc -p tsconfig.test.json --noEmit",
    "typecheck:r1": "tsc -p tsconfig.r1.json",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:db-rehearsal": "node scripts/release-db-rehearsal.mjs"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.13.11"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "better-sqlite3": "13.0.3",
    "execa": "10.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.13",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
